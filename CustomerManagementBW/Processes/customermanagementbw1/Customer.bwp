string-length($post.item/tns:Surname) > 0 and 
string-length($post.item/tns:PhoneNumber) > 0 and 
matches(string($post.item/tns:PhoneNumber), '^\+?[0-9]{9,15}$') and 
(
  $post.item/tns:TierDescription = 'Standard' or 
  $post.item/tns:TierDescription = 'Premium' or 
  $post.item/tns:TierDescription = 'Elite' or 
  string-length($post.item/tns:TierDescription) = 0
)]]></bpws:transitionCondition>
