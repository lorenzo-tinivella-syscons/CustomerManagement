                                    <tibex:DesignExpression>
                                    <tibex:expression
                                    expression="(&#xd;&#xa;  $get/parameters/tns1:customerGetParameters/tns1:TierDescription = 'Standard' or &#xd;&#xa;  $get/parameters/tns1:customerGetParameters/tns1:TierDescription = 'Premium' or &#xd;&#xa;  $get/parameters/tns1:customerGetParameters/tns1:TierDescription = 'Elite'&#xd;&#xa;)&#xd;&#xa;or&#xd;&#xa;(&#xd;&#xa;  string-length(normalize-space($get/parameters/tns1:customerGetParameters/tns1:Name)) > 0 &#xd;&#xa;  and &#xd;&#xa;  string-length(normalize-space($get/parameters/tns1:customerGetParameters/tns1:Surname)) > 0&#xd;&#xa;)" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                                    </tibex:DesignExpression>
                                    <bpws:transitionCondition expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"><![CDATA[(
  $get.parameters/tns1:TierDescription = 'Standard' or 
  $get.parameters/tns1:TierDescription = 'Premium' or 
  $get.parameters/tns1:TierDescription = 'Elite'
)
or
(
  string-length(normalize-space($get.parameters/tns1:Name)) > 0 
  and 
  string-length(normalize-space($get.parameters/tns1:Surname)) > 0
)]]></bpws:transitionCondition>
                                    </bpws:source>
                                    <bpws:source linkName="Empty2ToThrow2">
                                    <tibex:DesignExpression>
                                    <tibex:expression
