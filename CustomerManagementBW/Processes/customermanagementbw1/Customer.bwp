                                    <tibex:DesignExpression>
                                    <tibex:expression
                                    expression="string-length($post/item/tns:CustomerPostRequest/tns:Name) > 0 and &#xd;&#xa;string-length($post/item/tns:CustomerPostRequest/tns:Surname) > 0 and &#xd;&#xa;string-length($post/item/tns:CustomerPostRequest/tns:PhoneNumber) > 0 and &#xd;&#xa;matches(string($post/item/tns:CustomerPostRequest/tns:PhoneNumber), '^\+?[0-9]{9,15}$') and &#xd;&#xa;(&#xd;&#xa;  $post/item/tns:CustomerPostRequest/tns:TierDescription = 'Standard' or &#xd;&#xa;  $post/item/tns:CustomerPostRequest/tns:TierDescription = 'Premium' or &#xd;&#xa;  $post/item/tns:CustomerPostRequest/tns:TierDescription = 'Elite' or &#xd;&#xa;  string-length($post/item/tns:CustomerPostRequest/tns:TierDescription) = 0&#xd;&#xa;)" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
