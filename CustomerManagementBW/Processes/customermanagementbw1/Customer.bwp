    xmlns:ns0="http://www.tibco.com/pe/EngineTypes"
    xmlns:ns1="http://schemas.tibco.com/bw/plugins/basic/6.0/Exceptions"
    xmlns:ns2="http://www.tibco.com/namespaces/tnt/plugins/jdbc+98959954-538c-4a87-8996-9b469646a9b4+input"
    xmlns:ns3="http://www.tibco.com/namespaces/tnt/plugins/jdbc+98959954-538c-4a87-8996-9b469646a9b4+output"
