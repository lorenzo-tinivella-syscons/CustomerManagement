    <bpws:scope name="scope">
        <bpws:flow name="flow">
            <bpws:links/>
            <bpws:pick createInstance="yes" name="pick" tibex:xpdlId="ff463548-3c3b-4d63-a156-6a3c06bde2de">
                <bpws:onMessage operation="post" partnerLink="customer"
                    portType="ns:customer"
                    tibex:xpdlId="d7832fa3-45bb-4395-bc93-c03092fb54b2" variable="post">
                    <bpws:scope name="scope1">
                        <bpws:faultHandlers>
                            <bpws:catchAll
                                tibex:faultDetailsVar="FaultDetails"
                                tibex:faultNameVar="FaultName" tibex:xpdlId="8eaa6d16-bd8e-4d9c-bc92-ad66c69a97a2">
                                <bpws:scope name="scope3">
                                    <bpws:flow name="flow3">
                                    <bpws:links>
                                    <bpws:link
                                    name="Empty1ToReply" tibex:linkType="SUCCESSWITHCONDITION"/>
                                    <bpws:link
                                    name="Empty1ToReply1" tibex:linkType="SUCCESSWITHNOCONDITION"/>
                                    </bpws:links>
                                    <bpws:empty name="Empty1" tibex:xpdlId="f7be82c2-2979-4472-82f4-71f65e91e08c">
                                    <bpws:sources>
                                    <bpws:source linkName="Empty1ToReply">
                                    <tibex:DesignExpression>

                                    <tibex:expression
                                    expression="substring($_error/MsgCode, 1, 1) = &quot;4&quot;" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                                    </tibex:DesignExpression>

                                    <bpws:transitionCondition expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"><![CDATA[substring($_error/MsgCode, 1, 1) = "4"]]></bpws:transitionCondition>
                                    </bpws:source>
                                    <bpws:source linkName="Empty1ToReply1">
                                    <tibex:DesignExpression>

                                    <tibex:expression
                                    expression="##otherwise##" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                                    </tibex:DesignExpression>

                                    <bpws:transitionCondition expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"><![CDATA[##otherwise##]]></bpws:transitionCondition>
                                    </bpws:source>
                                    </bpws:sources>
                                    </bpws:empty>
                                    <bpws:reply
                                    faultName="clientFault"
                                    name="Reply_Error_post_4XX"
                                    operation="post"
                                    partnerLink="customer"
                                    portType="ns:customer"
                                    tibex:xpdlId="02b7c4e0-c63a-427b-9d0a-3241b3eec798" variable="Reply_Error_post_4XX-input">
                                    <tibex:inputBinding expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0">&lt;?xml version="1.0" encoding="UTF-8"?&gt;
&lt;xsl:stylesheet xmlns:xsl="http://www.w3.org/1999/XSL/Transform" xmlns:tns2="http://xmlns.example.com/20260610100812PLT" xmlns:tns3="http://tns.tibco.com/bw/REST" xmlns:xsd="http://www.w3.org/2001/XMLSchema" version="2.0"&gt;
    &lt;xsl:param name="_error"/&gt;
    &lt;xsl:template name="Reply-input" match="/"&gt;
        &lt;tns2:post4XXFaultMessage&gt;
            &lt;clientError&gt;
                &lt;tns3:client4XXError&gt;
                    &lt;statusCode&gt;
                        &lt;xsl:value-of select="xsd:integer($_error/MsgCode)"/&gt;
                    &lt;/statusCode&gt;
                    &lt;message&gt;
                        &lt;xsl:value-of select="$_error/Msg"/&gt;
                    &lt;/message&gt;
                &lt;/tns3:client4XXError&gt;
            &lt;/clientError&gt;
        &lt;/tns2:post4XXFaultMessage&gt;
    &lt;/xsl:template&gt;
&lt;/xsl:stylesheet&gt;</tibex:inputBinding>
